# Ankan reads environment variables (it does not load .env files itself).
# Load this file with:  set -a; source .env; set +a

# OCR engine: trocr (handwriting, line by line) or paddle (detection + recognition)
ANKAN_OCR_ENGINE=trocr
ANKAN_TROCR_MODEL=microsoft/trocr-base-handwritten
ANKAN_PADDLE_LANG=en

# Grader: lexical (default, offline) | embedding | llm | hybrid (llm proposes, embeddings check)
ANKAN_GRADER=lexical
# 1 = faster handwriting reading on CPU (8-bit model, about 2x faster)
ANKAN_FAST_OCR=0
ANKAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ANKAN_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...   (needed for llm and hybrid)

# cpu, cuda, mps; empty = pick automatically
ANKAN_DEVICE=

ANKAN_DATA_DIR=data
# Flag a sheet when any OCR line is below this confidence (0-1)
ANKAN_LOW_OCR_CONFIDENCE=0.6
# Hybrid: flag when the two graders differ by more than this share of the max marks
ANKAN_DISAGREEMENT_FRACTION=0.25
ANKAN_MAX_UPLOAD_MB=10
# Password the browser asks for (any username). Set it before sharing a link.
# ANKAN_PASSWORD=choose-a-password
